# Copy this file to .env, then fill in real values.
# NEVER commit the real .env file (it is git-ignored).
#
#   bash:        cp .env.example .env
#   PowerShell:  Copy-Item .env.example .env

# Port the server listens on. Render injects PORT automatically.
PORT=8124

# JWT signing secret. MUST be 32+ random characters or the server refuses to start.
# Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-32-plus-character-random-string

# JWT expiry
JWT_EXPIRES_IN=2h

# development | production | test
NODE_ENV=development

# SQLite database file path (relative to the repo root).
# Use :memory: to run with an in-memory database (used by the test suite).
DB_PATH=data/propcare.db

# Demo account password baked into the seeded database.
# Used on the login screen for one-click demo sign-in.
DEMO_PASSWORD=PropCare123!